# LearnLoop Intelligence — Environment Variables

# ============================================================================
# NVIDIA Nemotron AI Configuration (OPTIONAL)
# ============================================================================
# Without these, a clearly-labeled mock AI service is used
# Get API key from: https://build.nvidia.com
NEMOTRON_API_KEY=your_nemotron_api_key_here
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1

# ============================================================================
# Application Configuration
# ============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# Future: Supabase Configuration (when migrating from in-memory store)
# ============================================================================
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key